@font-face {
  font-family: "Amore Christmas";
  src: url("Amore Christmas.otf") format("opentype");
}

* { box-sizing: border-box; }

body {
  margin: 0;
  padding: 16px;
  overflow-x: hidden;
}

img, video {
  max-width: 100%;
  height: auto;
}

/* Title + messages: big on desktop, shrink on phones */
.container {
  font-family: "Amore Christmas";
  text-align: center;
}
.container p {
  font-size: clamp(40px, 12vw, 150px);
  line-height: 1.1;
  margin: 0.3em 0;
}
p.texts {
  font-size: clamp(24px, 7vw, 80px);
}

/* Gallery: 4 columns on desktop, 2 on phones */
.gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.gallery-item {
  border: 1px solid #ccc;
}
.gallery-item:hover {
  border: 1px solid #777;
}
.gallery-item img {
  width: 100%;
  height: auto;
  display: block;
}

p.text {
  text-align: center;
  font-size: clamp(24px, 6vw, 50px);
}

/* Pop-up box + video */
#survey > div {
  width: min(90%, 600px) !important;
}
#survey video {
  max-height: 60vh;
}

@media (max-width: 600px) {
  .gallery {
    grid-template-columns: repeat(2, 1fr);
  }
}
